  <div class="hint">Pfeiltasten ← → zum Blättern · F für Vollbild</div>

<script>
  var n = 4;
  var cur = 0;
  var frames = document.querySelectorAll('.frame');
  var dots = document.querySelectorAll('.dot');
  var count = document.getElementById('count');
  var prev = document.getElementById('prev');
  var next = document.getElementById('next');

  function show(i){
    cur = Math.max(0, Math.min(n - 1, i));
    frames.forEach(function(f, k){ f.classList.toggle('active', k === cur); });
    dots.forEach(function(d, k){ d.classList.toggle('active', k === cur); });
    count.textContent = (cur + 1) + ' / ' + n;
    prev.disabled = cur === 0;
    next.disabled = cur === n - 1;
  }
  prev.addEventListener('click', function(){ show(cur - 1); });
  next.addEventListener('click', function(){ show(cur + 1); });
  dots.forEach(function(d){ d.addEventListener('click', function(){ show(+d.dataset.i); }); });

  document.addEventListener('keydown', function(e){
    if(e.key === 'ArrowRight' || e.key === 'PageDown'){ show(cur + 1); }
    else if(e.key === 'ArrowLeft' || e.key === 'PageUp'){ show(cur - 1); }
    else if(e.key === 'Home'){ show(0); }
    else if(e.key === 'End'){ show(n - 1); }
    else if(e.key === 'f' || e.key === 'F'){ toggleFs(); }
  });

  function toggleFs(){
    if(!document.fullscreenElement){ document.documentElement.requestFullscreen(); }
    else{ document.exitFullscreen(); }
  }
  document.getElementById('fs').addEventListener('click', toggleFs);

  show(0);
</script>
