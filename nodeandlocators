<script>
  function setStep(step, on){
    var card = document.querySelector('.card[data-step=&quot;'+step+'&quot;]');
    var toks = document.querySelectorAll('.tok[data-step=&quot;'+step+'&quot;]');
    card.classList.toggle('show', on);
    toks.forEach(function(t){ t.classList.toggle('active', on); });
    var row = document.querySelector('.mrow[data-row=&quot;'+step+'&quot;]');
    if(row){ row.classList.toggle('show', on); }
  }
  function toggleStep(step){
    var card = document.querySelector('.card[data-step=&quot;'+step+'&quot;]');
    setStep(step, !card.classList.contains('show'));
  }
  document.querySelectorAll('.tok').forEach(function(t){
    t.addEventListener('click', function(){ toggleStep(t.dataset.step); });
  });
  document.querySelectorAll('.card').forEach(function(c){
    c.addEventListener('click', function(){ toggleStep(c.dataset.step); });
  });
  document.getElementById('all').addEventListener('click', function(){
    ['1','2','3','4','5'].forEach(function(s){ setStep(s, true); });
  });
  document.getElementById('reset').addEventListener('click', function(){
    ['1','2','3','4','5'].forEach(function(s){ setStep(s, false); });
  });
</script>
